# Copy to .env and fill it in. Never commit .env.
# Every value here is a LOCAL DEVELOPMENT default, not a secret. No AWS keys, ever (RNF-03).

# --- Local Airflow (airflow/docker-compose.yml, used by make airflow-*) ---
# Linux: set to the output of `id -u` so files in airflow/logs belong to you.
# Windows/macOS (Docker Desktop): keep 50000.
AIRFLOW_UID=50000
# Host port of the Airflow UI/API (http://localhost:8080)
AIRFLOW_PORT=8080
# Admin user of the local UI (local only)
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow

# --- AWS via IAM Identity Center (SSO) profile ---
# Create the profile on the host with `aws configure sso --profile portfolio`
# and log in with `aws sso login --profile portfolio` before triggering the DAG.
AWS_PROFILE=portfolio
AWS_REGION=us-east-1
# Host directory with the AWS config/SSO cache, mounted read-only into Airflow.
# Default: ~/.aws (Windows: %USERPROFILE%\.aws). Override only if it lives elsewhere.
# AWS_CONFIG_DIR=C:/Users/<you>/.aws
